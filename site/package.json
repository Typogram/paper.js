{
  "name": "@typogram/paper.js",
  "version": "0.12.18",
  "description": "Paper.js with an SVG renderer: the same API, rendered into a native SVG DOM tree instead of redrawn into a canvas on every frame",
  "license": "MIT",
  "homepage": "https://github.com/Typogram/paper.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Typogram/paper.js.git",
    "directory": "site"
  },
  "bugs": "https://github.com/Typogram/paper.js/issues",
  "keywords": [
    "paper.js",
    "paperjs",
    "svg",
    "renderer",
    "vector",
    "graphics",
    "canvas",
    "bezier",
    "path"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "./dist/index.js"
  ],
  "scripts": {
    "sync:paper": "node scripts/sync-paper.js",
    "dev": "npm run sync:paper && vite dev",
    "build": "npm run sync:paper && vite build",
    "preview": "vite preview",
    "package": "npm run sync:paper && svelte-kit sync && svelte-package && publint",
    "prepublishOnly": "npm run package",
    "check": "npm run sync:paper && svelte-kit sync && svelte-check --tsconfig ./jsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.9",
    "@sveltejs/kit": "^2.22.0",
    "@sveltejs/package": "^2.5.4",
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "publint": "^0.3.14",
    "svelte": "^5.39.6",
    "svelte-check": "^4.3.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6"
  }
}
